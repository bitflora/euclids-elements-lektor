# Lektor build output (regenerated from `lektor build`)
/build/

# Lektor's local config + caches
/.lektor/

# Lektor plugins. In-tree plugin source (e.g. packages/lektor-katex/) is
# tracked; per-plugin pip-install artifacts are not.
/packages/*.egg-info/
/packages/**/*.egg-info/
/packages/**/build/

# Node + KaTeX runtime — installed via `npm install`, ~1MB of fonts/JS.
# The katex.min.css + fonts copied into assets/css/katex/ stay tracked
# so deploys don't need npm at build time. node_modules itself is
# rebuilt from package.json + package-lock.json.
/node_modules/

# Per-project venv (optional — README documents both per-project and ~/venvs/lektor)
/.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Editor / OS noise
*.swp
.DS_Store
.idea/

# Local-dev geomlib bundle. The layout.html script tag swaps to this
# path when EUCLIDS_GEOMLIB_LOCAL is set; in practice it's a symlink to
# the sibling euclid/ repo's dist/bundle.js. Don't ship that to anyone
# else's checkout.
/assets/geomlib-dev.js

# Regenerated audit reports (scripts/audit-content.py, scripts/audit-review.py).
# Derived from content/ + Joyce's source HTML — regenerate rather than commit.
doc/journal/
.vscode/settings.json
